
{% liquid
  assign single_open = section.settings.single_open
  assign first_open = section.settings.first_open
  assign heading_size = section.settings.heading_size
  assign hide_chevron = true
  assign show_more_icon = true
  assign heading_size = heading_size | default: "h6"
%}

<div 
    id="{{ section.settings.section_id }}" 
    {% render 'section-properties', class: "specifications-section" %}
  >
    <div 
      class="specifications-container" 
      style="background-color: {{ section.settings.background_color }};"
    >
    {% for block in section.blocks %}

        {% if block.type == 'specifications' %}
    {%- assign specs = product.metafields.custom.product_specifications.value -%}
    {% unless specs %}{% continue %}{% endunless %}
  {% endif %}
  
  {% if block.type == 'dimensions' %}
    {%- assign dims = product.metafields.custom.dimensions.value -%}
    {% unless dims %}{% continue %}{% endunless %}
  {% endif %}
  
  {% if block.type == 'download_files' %}
    {%- assign download_file = product.metafields.custom.download_file.value -%}
    {% unless download_file %}{% continue %}{% endunless %}
  {% endif %}
  
  {% if block.type == 'cuidados_e_conservacao' %}
    {%- assign cuidados = product.metafields.custom.cuidados_e_conservacao.value -%}
    {% unless cuidados %}{% continue %}{% endunless %}
  {% endif %}


      {%- assign title = block.settings.title | t -%}       
      {%- assign content = block.settings.content -%}

      <details 
        {% if id %}id="{{ id | escape }}"{% endif %} 
        class="specifications-border accordion {% if size %}accordion--{{ size }}{% endif %} group" 
        aria-expanded="{% if open %}true{% else %}false{% endif %}" 
        is="accordion-disclosure" 
        data-single-open="{{ single_open }}"
        data-first-open="{{ first_open }}"
        style="border-color:{{ border_color }};"
        {% if open %}open{% endif %} 
        {{ block.shopify_attributes }}
      >
        <summary>
          {%- comment -%}iOS 14 does not support flex on the summary itself, so we have to use this extra div{%- endcomment -%}
          <div class="accordion__toggle bold">
            {%- if icon -%}
              <div class="text-with-icon">
                {%- render 'icon' with icon -%}
                <h1 class="{{ heading_size }}">
                  {{- title | escape -}}&nbsp;
                  {% if show_more_icon %}
                    <span class="show-more-icon"></span>
                  {% endif %}         
                </h1>
              </div>
            {%- else -%}
              <h1 class="{{ heading_size }}">
                {{- title | escape -}}&nbsp;
                {% if show_more_icon %}
                  <span class="show-more-icon"></span>
                {% endif %}      
              </h1>
            {%- endif -%}
            {% unless hide_chevron %}
              <span 
                class="circle-chevron group-hover:colors group-expanded:colors group-expanded:rotate">
                {%- render 'icon' with 'chevron-bottom-small' -%}
              </span>
            {% endunless %}
          
          </div>
        </summary>

        <div class="">         
          {{ content }}      
          {% case block.type %}
          {% when 'specifications' %}
            {% render 'specifications', heading_size: heading_size, block: block %}
          {% when 'dimensions' %}
            {% render 'product_dimensions', block: block %}
          {% when 'download_files' %}           
            {% render 'download_files', heading_size: heading_size, block: block %}
          {% when 'cuidados_e_conservacao' %}
            {% render 'cuidados_e_conservacao', heading_size: heading_size, block: block %}
            {% endcase %}
        
        </div>
          
      </details>

    {% endfor %}
  </div>
</div>

