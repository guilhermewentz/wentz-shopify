{%- render 'section-spacing-collapsing' -%}

<style>
  {%- assign section_background = section.settings.background | default: settings.background -%}
  {%- assign card_background = section.settings.product_card_background | default: settings.product_card_background -%}
  {%- assign card_blends = false -%}

  {%- unless section_background != 'rgba(0,0,0,0)' and card_background != 'rgba(0,0,0,0)' and section_background != card_background -%}
    {%- assign card_blends = true -%}
  {%- endunless -%}

  #shopify-section-{{ section.id }} .product-list {
    --product-list-gap: {% if section.settings.stack_products and section.settings.products_per_row_mobile == '2' %}{% if card_blends %}var(--product-list-row-gap){% endif %} var(--spacing-2){% else %}var(--product-list-row-gap) var(--product-list-column-gap){% endif %};
    --product-list-items-per-row: {{ section.settings.products_per_row_mobile | times: 1 }};
    --product-list-carousel-item-width: 74vw;
    --product-list-grid: {% if section.settings.stack_products %}auto / repeat(var(--product-list-items-per-row), minmax(0, 1fr)){% else %}auto / auto-flow var(--product-list-carousel-item-width){% endif %};
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} .product-list {
      --product-list-gap: var(--product-list-row-gap) var(--product-list-column-gap);
      --product-list-items-per-row: 2;
      --product-list-carousel-item-width: 36vw;
    }
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .product-list {
      --product-list-items-per-row: {{ section.settings.products_per_row_desktop }};
      --product-list-carousel-item-width: calc(var(--container-inner-width) / {{ section.settings.products_per_row_desktop }} - (var(--product-list-column-gap) / {{ section.settings.products_per_row_desktop }} * {{ section.settings.products_per_row_desktop | minus: 1 }}));
    }
  }
  {% if section.settings.full_width %}
    #shopify-section-{{ section.id }} > .section {
      padding-inline: 0;
    }
  {% endif %}

  /* WENTZ — Featured Collection Overlay */

#shopify-section-{{ section.id }} .floating-controls-container,
#shopify-section-{{ section.id }} .scrollable-with-controls {
  position: relative;
}

#shopify-section-{{ section.id }} .wentz-featured-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  z-index: 2;
  pointer-events: none;
}

#shopify-section-{{ section.id }} .wentz-featured-overlay h2 {
  margin: 0;
  color: {{ section.settings.heading_color | default: section.settings.text_color | default: '#000000' }};
}

/* WENTZ — Featured Collection Heading Alignment */

{% if section.settings.heading_alignment == 'center' %}
  #shopify-section-{{ section.id }} .section-header {
    position: relative;
  }

  #shopify-section-{{ section.id }} .section-header .prose {
    text-align: center;
    margin-inline: auto;
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} .section-header .text-with-icon {
      position: absolute;
      right: 0;
      top: 50%;
      transform: translateY(-50%);
    }
  }

{% elsif section.settings.heading_alignment == 'right' %}
  #shopify-section-{{ section.id }} .section-header .prose {
    text-align: right;
    margin-left: auto;
  }
{% endif %}

/* WENTZ — Featured Collection Footer */

#shopify-section-{{ section.id }} .wentz-featured-footer {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  align-items: baseline;
  width: 100%;
  margin-top: 40px;
  padding-inline: 12px;
  text-align: center;
}

#shopify-section-{{ section.id }} .wentz-featured-view-all {
  grid-column: 2;
  color: inherit;
  font: inherit;
  letter-spacing: inherit;
  text-decoration: underline;
  text-underline-offset: 3px;
  text-decoration-thickness: 1px;
  transition: opacity 0.25s ease;
}

#shopify-section-{{ section.id }} .wentz-featured-view-all:hover {
  opacity: 0.5;
}

#shopify-section-{{ section.id }} .wentz-loop-nav button {
  color: inherit;
  font: inherit;
  /* Optical adjustment: angle brackets are shorter than capitals in the site font. */
  font-size: 1.5em;
  letter-spacing: inherit;
  padding: 8px 12px;
  cursor: pointer;
}

#shopify-section-{{ section.id }} .wentz-loop-prev {
  grid-column: 1;
  grid-row: 1;
  justify-self: start;
}

#shopify-section-{{ section.id }} .wentz-loop-next {
  grid-column: 3;
  grid-row: 1;
  justify-self: end;
}

@media screen and (max-width: 699px) {
  #shopify-section-{{ section.id }} .wentz-featured-footer {
    margin-top: 28px;
  }
}


  /* Featured Collection 2 — carrossel isolado com repetição contínua */
  #shopify-section-{{ section.id }} .wentz-loop-scroller {
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  #shopify-section-{{ section.id }} .wentz-loop-scroller::-webkit-scrollbar { display: none; }
  #shopify-section-{{ section.id }} .wentz-loop-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 74vw;
    grid-template-columns: none;
    gap: 10px;
    width: max-content;
    max-width: none;
    padding: 0;
    transform: none;
  }
  #shopify-section-{{ section.id }} .wentz-loop-track > * { min-width: 0; }
  @media (min-width: 700px) {
    #shopify-section-{{ section.id }} .wentz-loop-track { grid-auto-columns: 36vw; }
  }
  @media (min-width: 1000px) {
    #shopify-section-{{ section.id }} .wentz-loop-track {
      grid-auto-columns: calc((100vw - ({{ section.settings.products_per_row_desktop | minus: 1 }} * 10px)) / {{ section.settings.products_per_row_desktop }});
    }
  }
</style>

<div {% render 'section-properties' %}>
  <div class="section-stack">
   {%- assign link_url = section.settings.link_url | default: section.settings.collection.url -%}

{%- if section.settings.heading_alignment == 'left' -%}
  {%- assign header_alignment = 'start' -%}
{%- elsif section.settings.heading_alignment == 'right' -%}
  {%- assign header_alignment = 'end' -%}
{%- else -%}
  {%- assign header_alignment = 'center' -%}
{%- endif -%}

{%- if section.settings.overlay_heading -%}
  {%- assign header_heading = blank -%}
{%- else -%}
  {%- assign header_heading = section.settings.title -%}
{%- endif -%}

{%- render 'section-header',
  subheading: section.settings.subheading,
  heading: header_heading,
  heading_size: section.settings.heading_size,
  heading_color: section.settings.heading_color,
  heading_gradient: section.settings.heading_gradient,
  content: section.settings.content,
  text_alignment: header_alignment
-%}

    <div class="{% if section.settings.show_progress_bar %}scrollable-with-controls{% else %}floating-controls-container{% endif %}">
      {%- if section.settings.overlay_heading and section.settings.title != blank -%}
  <div class="wentz-featured-overlay">
    <h2 class="{{ section.settings.heading_size }}">
      {{ section.settings.title | escape }}
    </h2>
  </div>
{%- endif -%}
      {%- assign scroll_area_id = 'wentz-loop-' | append: section.id -%}
      {%- if section.settings.use_article_related_products and article.metafields.custom.produtos_relacionados.value != blank -%}
        {%- assign products = article.metafields.custom.produtos_relacionados.value -%}
      {%- else -%}
        {%- assign products = section.settings.products | default: section.settings.collection.products -%}
      {%- endif -%}
      <div id="{{ scroll_area_id }}" class="wentz-loop-scroller" tabindex="0" aria-label="Carrossel de produtos">
        <div class="wentz-loop-track product-list">
          {%- for repetition in (1..3) -%}
            {%- for product in products limit: section.settings.products_count -%}
              {%- assign card_instance_id = 'loop-' | append: repetition | append: '-' | append: forloop.index -%}
              {%- render 'product-card', product: product, card_instance_id: card_instance_id, stacked: false, position: forloop.index, background: section.settings.product_card_background, text_color: section.settings.product_card_text_color, show_badges: true, configurator_variant_title: section.settings.configurator_variant_title -%}
            {%- else -%}
              {%- for i in (1..section.settings.products_count) -%}
                {%- capture placeholder_image -%}product-{% cycle '1', '2', '3', '4', '5', '6' %}{%- endcapture -%}
                {%- render 'product-card-placeholder', stacked: false, placeholder_image: placeholder_image, background: section.settings.product_card_background, text_color: section.settings.product_card_text_color, text_alignment: settings.product_info_alignment -%}
              {%- endfor -%}
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    </div>

    <nav class="wentz-featured-footer wentz-loop-nav" aria-label="Navegação do carrossel">
      <button type="button" class="wentz-loop-prev" aria-label="Produtos anteriores" aria-controls="{{ scroll_area_id }}">&lt;</button>
      {%- if section.settings.link_text != blank and link_url != blank -%}
        <a href="{{ link_url }}" class="wentz-featured-view-all">
          {{ section.settings.link_text | escape }}
        </a>
      {%- endif -%}
      <button type="button" class="wentz-loop-next" aria-label="Próximos produtos" aria-controls="{{ scroll_area_id }}">&gt;</button>
    </nav>

  </div>
</div>

<script>
  (() => {
    const sectionId = 'shopify-section-{{ section.id }}';
    const initialize = () => {
      const root = document.getElementById(sectionId);
      if (!root) return;
      const scroller = root.querySelector('.wentz-loop-scroller');
      const track = root.querySelector('.wentz-loop-track');
      if (!scroller || !track || scroller.dataset.loopReady === 'true') return;
      const items = Array.from(track.children);
      const count = Math.floor(items.length / 3);
      if (count < 2) return;
      scroller.dataset.loopReady = 'true';
      let resetting = false;
      let dragging = false;
      let pointerX = 0;
      let startingScroll = 0;
      const metrics = () => {
        const first = items[0].offsetLeft;
        const middle = items[count].offsetLeft;
        return { middle, span: middle - first, step: items[1].offsetLeft - first };
      };
      const center = () => {
        const { middle, step } = metrics();
        // Parte do card anterior permanece visível na borda esquerda.
        scroller.scrollLeft = middle - step * 0.35;
      };
      const normalize = () => {
        if (resetting || dragging) return;
        const { middle, span } = metrics();
        if (!span) return;
        const left = scroller.scrollLeft;
        if (left < middle - span * 0.6) {
          resetting = true;
          scroller.scrollLeft = left + span;
          resetting = false;
        } else if (left > middle + span * 0.6) {
          resetting = true;
          scroller.scrollLeft = left - span;
          resetting = false;
        }
      };
      const move = direction => {
        const { step } = metrics();
        scroller.scrollBy({ left: direction * step, behavior: 'smooth' });
      };
      root.querySelector('.wentz-loop-prev')?.addEventListener('click', () => move(-1));
      root.querySelector('.wentz-loop-next')?.addEventListener('click', () => move(1));
      scroller.addEventListener('scroll', normalize, { passive: true });
      scroller.addEventListener('pointerdown', event => {
        if (event.pointerType !== 'mouse' || event.target.closest('a, button, input, select')) return;
        dragging = true;
        pointerX = event.clientX;
        startingScroll = scroller.scrollLeft;
      });
      scroller.addEventListener('pointermove', event => {
        if (dragging) scroller.scrollLeft = startingScroll - (event.clientX - pointerX);
      });
      const endDrag = () => { if (dragging) { dragging = false; normalize(); } };
      window.addEventListener('pointerup', endDrag);
      window.addEventListener('pointercancel', endDrag);
      let previousWidth = scroller.clientWidth;
      const observer = new ResizeObserver(() => {
        if (scroller.clientWidth !== previousWidth) {
          previousWidth = scroller.clientWidth;
          center();
        }
      });
      observer.observe(scroller);
      requestAnimationFrame(center);
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initialize, { once: true });
    else initialize();
    document.addEventListener('shopify:section:load', event => {
      if (event.detail.sectionId === '{{ section.id }}') initialize();
    });
  })();
</script>

{% schema %}
{
  "name": "Featured Collection 2",
  "class": "shopify-section--featured-collection-2",
  "tag": "section",
  "disabled_on": {
    "templates": ["password"],
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "info": "Replaces collection when selected."
    },
    {
      "type": "checkbox",
      "id": "use_article_related_products",
      "label": "Use related products from blog post",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "stack_products",
      "label": "Stack products (not used in loop)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_progress_bar",
      "label": "Show carousel progress bar",
      "default": false
    },
    {
      "type": "range",
      "id": "products_count",
      "min": 2,
      "max": 50,
      "label": "Products to show",
      "default": 6
    },
    {
      "type": "select",
      "id": "products_per_row_mobile",
      "label": "Products per row (mobile)",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "products_per_row_desktop",
      "min": 2,
      "max": 5,
      "label": "Products per row (desktop)",
      "default": 3
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Featured collection"
    },
    {
      "type": "checkbox",
      "id": "overlay_heading",
      "label": "Overlay heading on products",
      "default": false
    },
    {
  "type": "select",
  "id": "heading_alignment",
  "label": "Heading alignment",
  "options": [
    {
      "value": "left",
      "label": "Left"
    },
    {
      "value": "center",
      "label": "Center"
    },
    {
      "value": "right",
      "label": "Right"
    }
  ],
  "default": "left"
},
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h0",
          "label": "XX-Large"
        },
        {
          "value": "h1",
          "label": "X-Large"
        },
        {
          "value": "h2",
          "label": "Large"
        },
        {
          "value": "h3",
          "label": "Medium"
        },
        {
          "value": "h4",
          "label": "Small"
        },
        {
          "value": "h5",
          "label": "X-Small"
        },
        {
          "value": "h6",
          "label": "XX-Small"
        }
      ],
      "default": "h6"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL",
      "info": "Default to collection URL."
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "View all"
    },
    {
      "type": "header",
      "content": "Colors",
      "info": "Gradient replaces solid colors when set."
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background"
