
<style>
  #shopify-section-{{ section.id }} {
    --content-over-media-overlay: {{ section.settings.overlay_color.rgb }} / {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }
</style>

<div class="image-link" {% render 'section-properties' %}>
  {% if section.blocks.size == 0 %}
    <div class="placeholder-container">{{- 'collection-1' | placeholder_svg_tag: 'placeholder' -}}</div>
    <div class="placeholder-container">{{- 'collection-1' | placeholder_svg_tag: 'placeholder' -}}</div>
  {% endif %}
  {%- capture class -%}media-content content-over-media{% endcapture %}
  {% for block in section.blocks %}
    {%- assign banner_url = block.settings.button_url -%}
    {%- if request.page_type == 'index' and block.settings.banner_link != blank -%}
      {%- assign banner_url = block.settings.banner_link -%}
    {%- endif -%}
    <image-link reveal-on-scroll="true" {% render 'surface', class: class %}>
      {% if block.settings.image != blank %}          
        <picture>
          <a class="link" href="{{ banner_url }}">
            <img loading="lazy" class="image" src="{{ block.settings.image | image_url }}"/>
            <img loading="lazy" class="mobile-image" src="{{ block.settings.mobile_image | image_url }}"/>
          </a>
        </picture>        
      {% endif %}
      {%- assign banner_label = block.settings.heading | default: block.settings.button_text | default: shop.name -%}
      {% render 'homepage-banner-link', url: banner_url, label: banner_label %}
      {%- assign homepage_banner_buttons = '' -%}
      <div class="{% if request.page_type == 'index' %} homepage-banner-content{% endif %} text-content {{ block.settings.mobile_text_position }} {{ block.settings.desktop_text_position }}" style="color:{{ block.settings.text_color }};">
        <div class="prose">     
          {%- if block.settings.subheading != blank -%}
            <p class="" {{ block.shopify_attributes }}>{{ block.settings.subheading | escape }}</p>
          {%- endif -%}      
          {%- if block.settings.heading != blank -%}
            <p class="{{ block.settings.heading_tag }}" {% if settings.heading_apparition != 'none' %}reveal-on-scroll="true"{% endif %} {{ block.shopify_attributes }}>
              {%- render 'styled-text', content: block.settings.heading, apparition_effect: true -%}
            </p>
          {%- endif -%}      
          {%- if block.settings.content != blank -%}
            <div {{ block.shopify_attributes }}>
              {{- block.settings.content -}}
            </div>
          {%- endif -%}  
          {%- if block.settings.button_text != blank -%}
            {%- capture banner_button -%}{% render 'button', content: block.settings.button_text, href: block.settings.button_url, size: block.settings.button_size, style: block.settings.style, background: block.settings.button_background, text_color: block.settings.button_text_color, block: block %}{%- endcapture -%}
                  {%- if request.page_type == 'index' -%}
                    {%- assign homepage_banner_buttons = homepage_banner_buttons | append: banner_button -%}
                  {%- else -%}
                    {{- banner_button -}}
                  {%- endif -%}
          {%- endif -%}    
        </div>
        {%- if request.page_type == 'index' and homepage_banner_buttons != blank -%}
          <div class="homepage-banner-actions">{{- homepage_banner_buttons -}}</div>
        {%- endif -%}
      </div>
    </image-link>
  {% endfor %}    
</div>


{% schema %}
{
  "name": "Image link",
  "class": "shopify-section--image-link",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "custom.overlay"
    ]
  },
  "settings": [
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Image Link",
      "limit": 2,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },
        {
          "type": "select",
          "id": "mobile_text_position",
          "label": "Mobile content position",
          "options": [
            {
              "value": "place-self-start text-start",
              "label": "Top left"
            },
            {
              "value": "place-self-start-center text-center",
              "label": "Top center"
            },
            {
              "value": "place-self-start-end text-end",
              "label": "Top right"
            },
            {
              "value": "place-self-center-start text-start",
              "label": "Middle left"
            },
            {
              "value": "place-self-center text-center",
              "label": "Middle center"
            },
            {
              "value": "place-self-center-end text-end",
              "label": "Middle right"
            },
            {
              "value": "place-self-end-start text-start",
              "label": "Bottom left"
            },
            {
              "value": "place-self-end-center text-center",
              "label": "Bottom center"
            },
            {
              "value": "place-self-end text-end",
              "label": "Bottom right"
            }
          ],
          "default": "place-self-center text-center"
        },
        {
          "type": "select",
          "id": "desktop_text_position",
          "label": "Desktop content position",
          "options": [
            {
              "value": "sm:place-self-start sm:text-start",
              "label": "Top left"
            },
            {
              "value": "sm:place-self-start-center sm:text-center",
              "label": "Top center"
            },
            {
              "value": "sm:place-self-start-end sm:text-end",
              "label": "Top right"
            },
            {
              "value": "sm:place-self-center-start sm:text-start",
              "label": "Middle left"
            },
            {
              "value": "sm:place-self-center sm:text-center",
              "label": "Middle center"
            },
            {
              "value": "sm:place-self-center-end sm:text-end",
              "label": "Middle right"
            },
            {
              "value": "sm:place-self-end-start sm:text-start",
              "label": "Bottom left"
            },
            {
              "value": "sm:place-self-end-center sm:text-center",
              "label": "Bottom center"
            },
            {
              "value": "sm:place-self-end sm:text-end",
              "label": "Bottom right"
            }
          ],
          "default": "sm:place-self-center sm:text-center"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#ffffff"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "subheading",
          "default": "Subheading"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "heading",
          "default": "Heading"
        },
        {
          "type": "select",
          "id": "heading_tag",
          "label": "Heading style",
          "options": [
            {
              "value": "h0",
              "label": "XX-Large"
            },
            {
              "value": "h1",
              "label": "X-Large"
            },
            {
              "value": "h2",
              "label": "Large"
            },
            {
              "value": "h3",
              "label": "Medium"
            },
            {
              "value": "h4",
              "label": "Small"
            },
            {
              "value": "h5",
              "label": "X-Small"
            },
            {
              "value": "h6",
              "label": "XX-Small"
            }
          ],
          "default": "h1"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Use this text to share information about your brand with your customers. Describe a product, share announcements, or welcome customers to your store.</p>"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Button style",
          "options": [
            {
              "value": "outline",
              "label": "Outline"
            },
            {
              "value": "fill",
              "label": "Fill"
            },
            {
              "value": "link",
              "label": "link"
            }
          ],
          "default": "fill"
        },
        {
          "type": "select",
          "id": "button_size",
          "label": "Size",
          "options": [
            {
              "value": "h0",
              "label": "XX-Large"
            },
            {
              "value": "h1",
              "label": "X-Large"
            },
            {
              "value": "h2",
              "label": "Large"
            },
            {
              "value": "h3",
              "label": "Medium"
            },
            {
              "value": "h4",
              "label": "Small"
            },
            {
              "value": "h5",
              "label": "X-Small"
            },
            {
              "value": "h6",
              "label": "XX-Small"
            }
          ],
          "default": "h5"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Text",
          "default": "Button text"
        },
        {
          "type": "url",
          "id": "banner_link",
          "label": "Link do banner",
          "info": "Na homepage, define o destino da imagem ou vídeo. Se vazio, usa o link do botão."
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Link"
        },
        {
          "type": "color",
          "id": "button_background",
          "label": "Background"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image link",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}