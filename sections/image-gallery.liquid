{% comment %}
Image Gallery by Marcos Watanabe (https://marcoswatanabe.com/)
{% endcomment %}

{%- unless settings.page_width != blank -%}
  {%- assign settings_page_width = 1600 -%}
{%- endunless -%}
{%- assign images_per_row = section.settings.images_per_row | default: 3 -%}
{%- assign images_per_row_mobile = section.settings.images_per_row_mobile | default: 3 -%}
{%- assign grid_gap = section.settings.grid_gap | default: 10 -%}

{% assign all_images_empty = true %}
{% assign journal_images = article.metafields.custom.galeria_de_imagens.value %}

{% if section.settings.use_journal_gallery and journal_images != blank %}
  {% assign all_images_empty = false %}
{% else %}
  {% for block in section.blocks %}
    {% if block.settings.image != blank %}
      {% assign all_images_empty = false %}
    {% endif %}
  {% endfor %}
{% endif %}

{% unless all_images_empty %}
<wentz-image-gallery>
<section {% render 'section-properties' %} id="section-{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    <div class="page-width"><h6>{{ section.settings.heading }}</h6></div>
  {%- endif -%}
  
  <div class="mw-image-gallery {% unless section.settings.full_width != blank %} page-width{% endunless %}">

  {% if section.settings.use_journal_gallery and journal_images != blank %}

    {%- for image in journal_images -%}

    <a
      href="{{ image | image_url: width: 1600 }}"
      data-desktop="{{ image | image_url: width: 1600 }}"
      data-mobile="{{ image | image_url: width: 749 }}"
      class="mw-image-gallery__item"
      target="_blank"
      title="{{ image.alt | escape }}"
    >

      <img
        src="{{ image | image_url: width: 1600 }}"
        alt="{{ image.alt | default: article.title | escape }}"
        loading="lazy"
        width="{{ image.width }}"
        height="{{ image.height }}"
      >

    </a>

  {%- endfor -%}

  {% else %}

    {%- for block in section.blocks -%}
      {%- assign image = block.settings.image -%}

      {% if image %}
        <a
          href="{{ image | image_url: width: 1600 }}"
          data-desktop="{{ image | image_url: width: 1600 }}"
          data-mobile="{{ image | image_url: width: 749 }}"
          class="mw-image-gallery__item"
          target="_blank"
          title="{{ image.alt | escape }}"
          {{ block.shopify_attributes }}
        >
         <img
          src="{{ image | image_url: width: 1600 }}"
          alt="{{ image.alt | default: article.title | escape }}"
          loading="lazy"
          width="{{ image.width }}"
         height="{{ image.height }}"
        >
        </a>
      {% endif %}

    {%- endfor -%}

  {% endif %}

</div>
  
  <div id="mw-modal-{{ section.id }}" class="mw-modal" role="dialog" aria-modal="true" aria-label="Image gallery" tabindex="-1">
    <div class="mw-modal-content">
      <img id="mw-modal-image-{{ section.id }}" src="" alt="">
      <a id="mw-modal-prev-{{ section.id }}" class="mw-modal-prev mw-arrow mw-arrow-left" href="#">&#10094;</a>
      <a id="mw-modal-next-{{ section.id }}" class="mw-modal-next mw-arrow mw-arrow-right" href="#">&#10095;</a>
      <a id="mw-modal-close-{{ section.id }}" class="mw-modal-close" href="#">&#10005;</a>
    </div>
  </div>
</section>
</wentz-image-gallery>
{% endunless %}

<style>
wentz-image-gallery { display: block; }

/* Gallery grid */
.mw-image-gallery {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  grid-gap: 5px;
  margin-bottom: 5px;

  /* Hide scrollbar for Firefox */
  scrollbar-width: none;
  -ms-overflow-style: none;
  
  /* Hide scrollbar for IE 10+ */
  -ms-overflow-style: -ms-autohiding-scrollbar;
}
  
/* Hide scrollbar for WebKit/Blink */
.mw-image-gallery::-webkit-scrollbar {
  width: 0;
  height: 0;
} 

/* Gallery images */
.mw-image-gallery a {
  width: 100%;
  height: 0;
  padding-bottom: 100%;
  object-fit: cover;
  cursor: pointer;
  position: relative;
  cursor:pointer;
}
  
.mw-image-gallery img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  cursor: pointer;
  position: absolute;
}

/* Modal popup */
.mw-modal {
  display: none;
  position: fixed;
  z-index: 9999;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: auto;
  background-color: rgba(0, 0, 0, 0.9);
}
.mw-modal.show {
  display:block;
}
.mw-modal-content { 
  display: flex;
  align-items: center; /* Vertical alignment */
  justify-content: center; /* Horizontal alignment */
  margin: auto;
  width: 80%;
  height:100%;
  max-width: 1200px;
}

.mw-modal-content img {
  /*width: 100%;
  height: 100%;*/
  object-fit: contain;
}
.mw-modal-content img {
  max-width: 100vw;
  max-height: 100vh;
}
.mw-modal-close {
  display: block;
  position: absolute;
  right: 50px;
  top: 50px;
  z-index: 9999;
  width: 50px;
  height: 50px;
  color: #ffffff80;
  line-height: 50px;
  cursor: pointer;
  text-decoration: none;
  font-size: 40px;
}
  @media (max-width: 768px) {
    .mw-modal-close {
      right: 5px;
      top: 5px;
    }
  }
/* Arrows */
.mw-arrow {
  display: block;
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 99999;
  width: 50px;
  height: 50px;
  background-color: rgba(255, 255, 255, 0.5);
  text-align: center;
  cursor: pointer;
  line-height:50px;
  color: #000;
}

.mw-arrow:hover {
  background-color: rgba(255, 255, 255, 0.8);
}

.mw-arrow-left {
  left: 0;
}

.mw-arrow-right {
  right: 0;
}
  @media (max-width: 768px) {
  {%- if section.settings.mobile_slider != blank -%}
      .mw-image-gallery {
        display: flex;
        flex-wrap: nowrap;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        grid-gap:5px;
        grid-gap: {{ grid_gap | divided_by: 2 }}px;
      }
    
      .mw-image-gallery a {
        width: 70%;
        height: auto;
        margin-right: 10px;
        scroll-snap-align: start;
        flex: 0 0 70%;
        padding-bottom: 70%;
      }
    
      .mw-image-gallery a:last-child {
        margin-right: 0;
        margin-left: auto;
        scroll-snap-align: end;
      }
  {%- else -%}
    .mw-image-gallery {
      grid-template-columns: repeat({{ images_per_row_mobile }}, 1fr);
      grid-gap: {{ grid_gap | divided_by: 2 }}px;
    }
  {%- endif -%}
  }
  @media (min-width: 769px) {
    .mw-image-gallery {
      display: grid;
      grid-template-columns: repeat({{ images_per_row }}, 1fr);
      grid-gap: {{ grid_gap }}px;
    }
  }
</style>


{% javascript %}
if (!customElements.get('wentz-image-gallery')) {
  customElements.define('wentz-image-gallery', class extends HTMLElement {
    connectedCallback() {
      this._controller?.abort();
      this._controller = new AbortController();
      const { signal } = this._controller;
      const images = Array.from(this.querySelectorAll('.mw-image-gallery a'));
      const modal = this.querySelector('.mw-modal');
      const modalImage = modal?.querySelector('img');
      if (!images.length || !modal || !modalImage) return;

      const closeButton = modal.querySelector('.mw-modal-close');
      let currentIndex = 0;
      let previousFocus = null;

      const show = index => {
        currentIndex = (index + images.length) % images.length;
        const image = images[currentIndex];
        modalImage.src = window.innerWidth > 749 ? image.dataset.desktop : image.dataset.mobile;
        modalImage.alt = image.querySelector('img')?.alt || '';
        modal.classList.add('show');
      };
      this._closeModal = () => {
        modal.classList.remove('show');
        if (previousFocus?.isConnected) previousFocus.focus();
      };

      images.forEach((image, index) => {
        image.addEventListener('click', event => {
          event.preventDefault();
          previousFocus = document.activeElement;
          show(index);
          (closeButton || modal).focus();
        }, { signal });
      });
      modal.querySelector('.mw-modal-prev')?.addEventListener('click', event => {
        event.preventDefault();
        show(currentIndex - 1);
      }, { signal });
      modal.querySelector('.mw-modal-next')?.addEventListener('click', event => {
        event.preventDefault();
        show(currentIndex + 1);
      }, { signal });
      closeButton?.addEventListener('click', event => {
        event.preventDefault();
        this._closeModal();
      }, { signal });
      modal.addEventListener('click', event => {
        if (event.target === modal) this._closeModal();
      }, { signal });
      modal.addEventListener('keydown', event => {
        if (event.key === 'Escape') {
          event.preventDefault();
          this._closeModal();
        } else if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
          event.preventDefault();
          show(currentIndex + (event.key === 'ArrowRight' ? 1 : -1));
        } else if (event.key === 'Tab') {
          const controls = Array.from(modal.querySelectorAll('a[href], button:not([disabled])'));
          const first = controls[0];
          const last = controls[controls.length - 1];
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        }
      }, { signal });
    }

    disconnectedCallback() {
      this._controller?.abort();
      this._closeModal = null;
    }
  });
}
{% endjavascript %}

{% schema %}
{
  "name": "Image Gallery",
  "settings": [
    {
      "type":"richtext",
      "id":"heading",
      "label":"Heading",
      "default":"<p>Image Gallery</p>"
    },
    {
      "type": "range",
      "id": "images_per_row",
      "label": "Images per row",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "images_per_row_mobile",
      "label": "Images per row on mobile",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 10
    },
    {
      "type":"checkbox",
      "id":"full_width",
      "label":"Full width gallery",
      "default":true
    },
    {
  "type":"checkbox",
  "id":"mobile_slider",
  "label":"Slider on mobile",
  "default":true,
  "info":"If checked, the images per row on mobile is ignored"
  },
  {
  "type":"checkbox",
  "id":"use_journal_gallery",
  "label":"Use Journal gallery",
  "default":false,
  "info":"Uses all images from the Blog Post image gallery metafield."
  }
  ],
  "blocks":[
    {
      "type":"image",
      "name":"Image",
      "settings":[
        {
          "type":"image_picker",
          "id":"image",
          "label":"Image"
        },
         {
          "type":"text",
          "id":"alt",
          "label":"Image description",
          "default":"Image description"
        }
      ]
    }
  ],
  "presets":[
    {
      "name":"Image Gallery",
      "category":"Image"
    }
  ]
  
}
{% endschema %}