{% if show_consultant_button %}

  {%- assign consultant_button_label = 'product.general.consultant_button' | t -%}

  {%- assign consultant_language = request.locale.iso_code | split: '-' | first | downcase -%}
  {%- assign consultant_use_whatsapp = false -%}
  {%- if localization.country.iso_code == 'BR' and consultant_language != 'en' -%}
    {%- assign consultant_use_whatsapp = true -%}
  {%- endif -%}

  {%- assign restock_variant = product.selected_or_first_available_variant -%}
  {%- if restock_variant.inventory_management != blank and restock_variant.inventory_policy == 'deny' and restock_variant.inventory_quantity <= 0 and restock_variant.available == false -%}
    {%- assign consultant_use_whatsapp = false -%}
    {%- assign restock_product_url = shop.url | append: product.url | append: '?variant=' | append: restock_variant.id -%}
    {%- capture restock_product_name -%}
      {{ product.title }}{% unless product.has_only_default_variant %} — {{ restock_variant.title }}{% endunless %}
    {%- endcapture -%}
    {%- if consultant_language == 'pt' -%}
      {%- assign consultant_button_label = 'Avise-me quando voltar' -%}
      {%- assign email_subject = 'Aviso de reposição — ' | append: restock_product_name -%}
      {%- capture email_body -%}
Olá, equipe WENTZ!

Por favor, avisem-me quando este produto voltar a estar disponível:

{{ restock_product_name }}
{{ restock_product_url }}

Obrigado!
      {%- endcapture -%}
    {%- else -%}
      {%- assign consultant_button_label = 'Notify me when available' -%}
      {%- assign email_subject = 'Back in stock alert — ' | append: restock_product_name -%}
      {%- capture email_body -%}
Hello WENTZ team,

Please let me know when this product is available again:

{{ restock_product_name }}
{{ restock_product_url }}

Thank you!
      {%- endcapture -%}
    {%- endif -%}
    {%- assign email_subject = email_subject | strip | url_encode | replace: '+', '%20' -%}
    {%- assign email_body = email_body | strip | url_encode | replace: '+', '%20' -%}
    {%- assign consultant_url = 'mailto:info@wentz.design?subject=' | append: email_subject | append: '&body=' | append: email_body -%}
  {% elsif consultant_use_whatsapp %}

    {%- if consultant_language == 'pt' -%}
      {%- assign consultant_product_url = shop.url | append: product.url -%}
      {%- capture portuguese_consultant_message -%}
Olá! Gostaria de saber mais sobre o produto {{ product.title }}.

{{ consultant_product_url }}
      {%- endcapture -%}
      {%- assign encoded_consultant_message = portuguese_consultant_message | strip | url_encode | replace: '+', '%20' -%}
      {%- assign consultant_url = 'https://wa.me/' | append: consultant_number | append: '?text=' | append: encoded_consultant_message -%}
    {%- else -%}
      {%- assign consultant_url = 'https://wa.me/' | append: consultant_number | append: '?text=' | append: consultant_message -%}
    {%- endif -%}

  {% else %}

    {%- assign email_subject = 'Quote Request - ' | append: product.title | url_encode | replace: '+', '%20' -%}

    {%- assign product_url = shop.url | append: product.url -%}

    {%- capture email_body -%}
Hello WENTZ team,

I would like to request a quote for the following product:

{{ product.title }}
{{ product_url }}

Thank you.
    {%- endcapture -%}

    {%- assign email_body = email_body | strip | url_encode | replace: '+', '%20' -%}

    {%- assign consultant_url = 'mailto:info@wentz.design?subject=' | append: email_subject | append: '&body=' | append: email_body -%}

  {% endif %}

  {%- assign consultant_is_primary = false -%}
  {%- if localization.country.iso_code != 'BR' or product.selected_or_first_available_variant.available != true -%}
    {%- assign consultant_is_primary = true -%}
  {%- endif -%}

  <div id="consultant-button" class="simulator-button">
    <a
      id="simulator-button"
      class="button button--lg w-full{% unless consultant_is_primary %} button--outline{% endunless %}"
      href="{{ consultant_url | escape }}"
      {% unless consultant_use_whatsapp %}
        data-no-instant
      {% endunless %}
      {% if consultant_use_whatsapp %}
        target="_blank" rel="noopener noreferrer"
      {% endif %}
    >
      {{ consultant_button_label }}
    </a>
  </div>

{% endif %}